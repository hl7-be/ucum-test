meta {
  name: spoon is not in BeUcumAllVS
  type: http
  seq: 11
}

post {
  url: {{txBase}}/ValueSet/$validate-code
  body: json
  auth: none
}

headers {
  Content-Type: application/fhir+json
  Accept: application/fhir+json
}

body:json {
  {
    "resourceType": "Parameters",
    "parameter": [
      {
        "name": "valueSet",
        "resource": {
          "resourceType": "ValueSet",
          "status": "draft",
          "name": "BeUcumAllVS",
          "id": "BeUcumAllVS",
          "title": "All of UCUM",
          "description": "Every valid UCUM expression. Annotations such as `{spoon}` and `{lepel}` are valid UCUM, so this allows them. Same content as the FHIR ValueSet `ucum-units`.",
          "url": "https://www.ehealth.fgov.be/standards/fhir/ucum-test/ValueSet/BeUcumAllVS",
          "experimental": true,
          "compose": {
            "include": [
              {
                "system": "http://unitsofmeasure.org"
              }
            ]
          }
        }
      },
      {
        "name": "system",
        "valueUri": "http://unitsofmeasure.org"
      },
      {
        "name": "code",
        "valueCode": "spoon"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  const p = (res.body.parameter || []);
  const result = p.find(x => x.name === 'result');
  const message = p.find(x => x.name === 'message');
  test("result is false", function() {
    expect(result && result.valueBoolean, message && message.valueString).to.equal(false);
  });
}

docs {
  Without braces this is not UCUM at all (no such unit atom).
}
