meta {
  name: {tablet} is in BeUcumWithoutSpoonVS
  type: http
  seq: 8
}

post {
  url: {{txBase}}/ValueSet/$validate-code
  body: json
  auth: none
}

headers {
  Content-Type: application/fhir+json
  Accept: application/fhir+json
}

body:json {
  {
    "resourceType": "Parameters",
    "parameter": [
      {
        "name": "valueSet",
        "resource": {
          "resourceType": "ValueSet",
          "status": "draft",
          "name": "BeUcumWithoutSpoonVS",
          "id": "BeUcumWithoutSpoonVS",
          "title": "All of UCUM except {spoon} and {lepel}",
          "description": "All of UCUM, minus the two annotations. The exclusion only removes those two exact codes: `mL{spoon}`, `{spoon}/d`, `{Spoon}` and `{teaspoon}` are still in the value set.",
          "url": "https://www.ehealth.fgov.be/standards/fhir/ucum-test/ValueSet/BeUcumWithoutSpoonVS",
          "experimental": true,
          "compose": {
            "include": [
              {
                "system": "http://unitsofmeasure.org"
              }
            ],
            "exclude": [
              {
                "system": "http://unitsofmeasure.org",
                "concept": [
                  {
                    "code": "{spoon}",
                    "display": "spoon"
                  },
                  {
                    "code": "{lepel}",
                    "display": "lepel"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "name": "system",
        "valueUri": "http://unitsofmeasure.org"
      },
      {
        "name": "code",
        "valueCode": "{tablet}"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  const p = (res.body.parameter || []);
  const result = p.find(x => x.name === 'result');
  const message = p.find(x => x.name === 'message');
  test("result is true", function() {
    expect(result && result.valueBoolean, message && message.valueString).to.equal(true);
  });
}

docs {
  `{tablet}` against `BeUcumWithoutSpoonVS`.
}
